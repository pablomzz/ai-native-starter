{
  "projectName": "ai-native-starter",
  "description": "A small project built with an AI-native workflow.",
  "owners": [
    "pablomzz"
  ],
  "timezone": "Etc/GMT+3",
  "defaultBranch": "main",
  "stack": "web",
  "commands": {
    "build": "echo \"no build step: the page runs as it is\"",
    "test": "node --test",
    "lint": "echo \"no linter yet\"",
    "run": "node tools/open.js src/index.html"
  },
  "protectedPaths": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key"
  ],
  "askBeforeEditing": [
    ".claude/settings.json",
    ".claude/settings.local.json",
    "tools/hooks/",
    "tools/lib.js",
    "evals/cases/",
    "project.config.json"
  ],
  "planRequiredFor": [
    "src/"
  ],
  "planMaxAgeDays": 14,
  "askBeforeCommands": [
    "git push[^;&|]*[\\s:+](main|master)(\\s|$|;|&|\\|)",
    "git push[^;&|]*\\s(--force|--force-with-lease|-f)(\\s|$)",
    "gh pr merge",
    "git reset --hard",
    "rm -rf",
    "deploy"
  ]
}
