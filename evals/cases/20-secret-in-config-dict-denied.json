{
  "hook": "block-secrets",
  "why": "a key written as config[\"SECRET_KEY\"] = \"...\" (Flask style) must be refused",
  "input": {
    "tool_name": "Write",
    "tool_input": {
      "file_path": "src/app.py",
      "content": [
        "app.config[\"SECRET",
        "_KEY\"] = \"x9f8s7d6f5g4h3j2\""
      ]
    }
  },
  "expect": "deny"
}
